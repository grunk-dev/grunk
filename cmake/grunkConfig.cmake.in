@PACKAGE_INIT@

# find_dependency() itself comes from this module, not from @PACKAGE_INIT@ (which
# only sets up PACKAGE_PREFIX_DIR and the relative-path macros) - never actually
# exercised until grunk-occt/grunk-adolc switched from vendoring grunk's source via
# FetchContent to a real find_package(grunk), which is the first time this file was
# ever processed by a consumer at all.
include(CMakeFindDependencyMacro)

# Import the exported targets
include("${CMAKE_CURRENT_LIST_DIR}/grunkTargets.cmake")

# Find transitively required packages if they aren't already available as targets.
if (NOT TARGET parametric::parametric)
  find_dependency(parametric REQUIRED)
endif()

if (NOT TARGET sol2::sol2)
  find_dependency(sol2 REQUIRED)
endif()

if (NOT TARGET Lua::Lua)
  find_dependency(Lua REQUIRED)
endif()

# recipe depends on yaml-cpp; ensure the consumer finds it as well
if (TARGET grunk::recipe)
  if (NOT TARGET yaml-cpp::yaml-cpp)
    find_dependency(yaml-cpp REQUIRED)
  endif()
endif()

# package version
set(grunk_VERSION "@PACKAGE_VERSION@")