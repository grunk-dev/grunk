uses:
  grunk: 0.2.2
  geo: 0.2.0
  grocc: 0.1.1
parameters:
  w_armrest: !<double> 0.050000000000000003
  w_sitting_surface: !<double> 0.45000000000000001
steps:
  - !<recipes::seat> [{seat: single_seat}, {w_armrest: w_armrest, w_sitting_surface: w_sitting_surface}]
recipes:
  support:
    uses:
      grunk: 0.2.2
      geo: 0.2.0
      grocc: 0.1.1
    parameters:
      l_cushion: !<double> 0.45000000000000001
      support_y: !<double> 0
      support_z: !<double> 0
      w_support: !<double> 0.029999999999999999
      h_sitting_surface: !<double> 0.40000000000000002
      h_cushion: !<double> 0.12
    steps:
      - !<expr> [dz_support, h_sitting_surface - h_cushion]
      - !<expr> [dx_support, 0.5*l_cushion]
      - !<expr> [support_x, (l_cushion - dx_support) / 2]
      - !<grocc::gp_Pnt> [[support_pos], [support_x, support_y, support_z]]
      - !<grocc::BRepPrimAPI_MakeBox> [[support], [support_pos, dx_support, w_support, dz_support]]
  seat:
    uses:
      grunk: 0.2.2
      geo: 0.2.0
      grocc: 0.1.1
    parameters:
      w_armrest: !<double> 0.050000000000000003
      w_sitting_surface: !<double> 0.45000000000000001
    steps:
      - !<recipes::seat_cushion> [{h_sitting_surface: h_sitting_surface, h_cushion: h_cushion, l_cushion: l_cushion, cushion: seat_cushion}, {w_sitting_surface: w_sitting_surface, w_armrest: w_armrest}]
      - !<recipes::backrest> [{back: backrest_reclined, dx_back: dx_back, phi_recline: phi_recline}, {h_cushion: h_cushion, h_sitting_surface: h_sitting_surface, l_cushion: l_cushion, w_sitting_surface: w_sitting_surface}]
      - !<recipes::armrest> [{armrest: armrest}, {dx_back: dx_back, l_cushion: l_cushion, phi_recline: phi_recline, h_sitting_surface: h_sitting_surface, w_armrest: w_armrest}]
      - !<script>
        steps:
          - !<grocc::TopoDS_Compound> [[single_seat], ~]
          - !<grocc::BRep_Builder> [[aBuilder], ~]
          - !<grocc::BRep_Builder::MakeCompound> [~, [aBuilder, single_seat]]
          - !<grocc::BRep_Builder::Add> [~, [aBuilder, single_seat, cushion]]
          - !<grocc::BRep_Builder::Add> [~, [aBuilder, single_seat, back]]
          - !<grocc::BRep_Builder::Add> [~, [aBuilder, single_seat, armrest]]
        returns:
          - single_seat
    recipes:
      seat_cushion:
        uses:
          grunk: 0.2.2
          geo: 0.2.0
          grocc: 0.1.1
        parameters:
          h_cushion: !<double> 0.12
          w_armrest: !<double> 0.050000000000000003
          h_sitting_surface: !<double> 0.40000000000000002
          l_cushion: !<double> 0.45000000000000001
          w_sitting_surface: !<double> 0.45000000000000001
          seat_x: !<double> 0
          f1_i1: !<int> 1
          f1_i3: !<int> 3
          f2_i0: !<int> 0
          seat_fillet_radius_leftright: !<double> 0.01
          f2_i3: !<int> 3
        steps:
          - !<expr> [seat_fillet_radius_frontback, h_cushion / 2.05]
          - !<expr> [w_cushion, w_sitting_surface + w_armrest]
          - !<expr> [seat_z, h_sitting_surface - h_cushion]
          - !<expr> [seat_y, "- w_armrest / 2"]
          - !<grocc::gp_Pnt> [[seat_pos], [seat_x, seat_y, seat_z]]
          - !<grocc::BRepPrimAPI_MakeBox> [[seat_box], [seat_pos, l_cushion, w_cushion, h_cushion]]
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[f1], [seat_box]]
              - !<geo::internal::GetEdge> [[e1], [seat_box, f1_i1]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f1, seat_fillet_radius_frontback, e1]]
              - !<geo::internal::GetEdge> [[e3], [seat_box, f1_i3]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f1, seat_fillet_radius_frontback, e3]]
            returns:
              - f1
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[seat_cushion], [f1]]
              - !<geo::internal::GetEdge> [[e1], [f1, f2_i0]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [seat_cushion, seat_fillet_radius_leftright, e1]]
              - !<geo::internal::GetEdge> [[e3], [f1, f2_i3]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [seat_cushion, seat_fillet_radius_leftright, e3]]
            returns:
              - seat_cushion
      backrest:
        uses:
          grunk: 0.2.2
          geo: 0.2.0
          grocc: 0.1.1
        parameters:
          w_sitting_surface: !<double> 0.45000000000000001
          l_cushion: !<double> 0.45000000000000001
          h_cushion: !<double> 0.12
          h_sitting_surface: !<double> 0.40000000000000002
          phi_recline: !<double> 0.17453292519943295
          dx_back: !<double> 0.050000000000000003
          rot_pnt_y: !<double> 0
          rot_dir_x: !<double> 0
          rot_dir_y: !<double> 1
          rot_dir_z: !<double> 0
          backrest_posy: !<double> 0
          h_back: !<double> 0.81999999999999995
          f2_i0: !<int> 9
          backrest_radius_leftright: !<double> 0.10000000000000001
          f2_i3: !<int> 11
          f4_i06: !<int> 6
          t_headrest: !<double> 0.02
          border_headrest: !<double> 0.02
          h_headrest: !<double> 0.20000000000000001
          f5_i08: !<int> 8
          headrest_radius: !<double> 0.080000000000000002
          f5_i09: !<int> 9
          f5_i10: !<int> 10
          f5_i11: !<int> 11
          f6_i0: !<int> 0
          headrest_radius2: !<double> 0.014999999999999999
        steps:
          - !<expr> [headrest_width, w_sitting_surface - 2 * border_headrest]
          - !<expr> [backrest_posz, h_sitting_surface + h_back - h_cushion - h_headrest - border_headrest]
          - !<expr> [headrest_posx, l_cushion - t_headrest]
          - !<grocc::gp_Pnt> [[headrest_pos], [headrest_posx, border_headrest, backrest_posz]]
          - !<grocc::BRepPrimAPI_MakeBox> [[headrest_box], [headrest_pos, t_headrest, headrest_width, h_headrest]]
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[f5], [headrest_box]]
              - !<geo::internal::GetEdge> [[e08], [headrest_box, f5_i08]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f5, headrest_radius, e08]]
              - !<geo::internal::GetEdge> [[e09], [headrest_box, f5_i09]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f5, headrest_radius, e09]]
              - !<geo::internal::GetEdge> [[e10], [headrest_box, f5_i10]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f5, headrest_radius, e10]]
              - !<geo::internal::GetEdge> [[e11], [headrest_box, f5_i11]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f5, headrest_radius, e11]]
            returns:
              - f5
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[headrest], [f5]]
              - !<geo::internal::GetEdge> [[e], [f5, f6_i0]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [headrest, headrest_radius2, e]]
            returns:
              - headrest
          - !<expr> [backrest_radius_top, 0.9 * dx_back]
          - !<expr> [seat_z, h_sitting_surface - h_cushion]
          - !<grocc::gp_Pnt> [[backrest_pos], [l_cushion, backrest_posy, seat_z]]
          - !<grocc::BRepPrimAPI_MakeBox> [[backrest_box], [backrest_pos, dx_back, w_sitting_surface, h_back]]
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[f3], [backrest_box]]
              - !<geo::internal::GetEdge> [[e09], [backrest_box, f2_i0]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f3, backrest_radius_leftright, e09]]
              - !<geo::internal::GetEdge> [[e11], [backrest_box, f2_i3]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [f3, backrest_radius_leftright, e11]]
            returns:
              - f3
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[backrest], [f3]]
              - !<geo::internal::GetEdge> [[e06], [f3, f4_i06]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [backrest, backrest_radius_top, e06]]
            returns:
              - backrest
          - !<script>
            steps:
              - !<grocc::TopoDS_Compound> [[back], ~]
              - !<grocc::BRep_Builder> [[aBuilder], ~]
              - !<grocc::BRep_Builder::MakeCompound> [~, [aBuilder, back]]
              - !<grocc::BRep_Builder::Add> [~, [aBuilder, back, backrest]]
              - !<grocc::BRep_Builder::Add> [~, [aBuilder, back, headrest]]
            returns:
              - back
          - !<grocc::gp_Dir> [[rot_dir], [rot_dir_x, rot_dir_y, rot_dir_z]]
          - !<grocc::gp_Pnt> [[rot_pnt], [l_cushion, rot_pnt_y, h_sitting_surface]]
          - !<grocc::gp_Ax1> [[rot_ax], [rot_pnt, rot_dir]]
          - !<script>
            steps:
              - !<grocc::gp_Trsf> [[t], ~]
              - !<grocc::gp_Trsf::SetRotation> [~, [t, rot_ax, phi_recline]]
              - !<grocc::BRepBuilderAPI_Transform> [[backrest_reclined], [back, t]]
            returns:
              - backrest_reclined
      armrest:
        uses:
          grunk: 0.2.2
          geo: 0.2.0
          grocc: 0.1.1
        parameters:
          l_cushion: !<double> 0.45000000000000001
          w_armrest: !<double> 0.050000000000000003
          phi_recline: !<double> 0.17453292519943295
          h_sitting_surface: !<double> 0.40000000000000002
          dx_back: !<double> 0.050000000000000003
          pnt_y: !<double> 0
          dir_y: !<double> 0
          uvmin: !<double> 0
          uvmax: !<double> 1
          h_armrest: !<double> 0.20000000000000001
          f6_i01: !<int> 1
          armrest_radius: !<double> 0.050000000000000003
        steps:
          - !<expr> [armrest_posy, "- w_armrest"]
          - !<expr> [l_armrest, 0.75*l_cushion]
          - !<expr> [armrest_dx, l_armrest + h_armrest * sin(phi_recline)]
          - !<expr> [armrest_posx, l_cushion - l_armrest + dx_back * cos(phi_recline) / 2]
          - !<grocc::gp_Pnt> [[armrest_pos], [armrest_posx, armrest_posy, h_sitting_surface]]
          - !<grocc::BRepPrimAPI_MakeBox> [[armrest_box], [armrest_pos, armrest_dx, w_armrest, h_armrest]]
          - !<script>
            steps:
              - !<grocc::BRepFilletAPI_MakeFillet> [[armrest_nobop], [armrest_box]]
              - !<geo::internal::GetEdge> [[e], [armrest_box, f6_i01]]
              - !<grocc::BRepFilletAPI_MakeFillet::Add> [~, [armrest_nobop, armrest_radius, e]]
            returns:
              - armrest_nobop
          - !<expr> [dir_z, -sin(phi_recline)]
          - !<expr> [dir_x, cos(phi_recline)]
          - !<expr> [pnt_x, l_cushion + dx_back * cos(phi_recline) / 2.0]
          - !<script>
            steps:
              - !<grocc::gp_Pnt> [[pln_pnt], [pnt_x, pnt_y, h_sitting_surface]]
              - !<grocc::gp_Dir> [[pln_dir], [dir_x, dir_y, dir_z]]
              - !<grocc::gp_Pln> [[pln], [pln_pnt, pln_dir]]
              - !<grocc::BRepBuilderAPI_MakeFace> [[face_maker], [pln, uvmin, uvmax, uvmin, uvmax]]
              - !<grocc::BRepBuilderAPI_MakeFace::Face> [[face], [face_maker]]
              - !<grocc::gp_Pnt::Translated> [[pnt], [pln_pnt, pln_dir]]
              - !<grocc::BRepPrimAPI_MakeHalfSpace> [[halfspace], [face, pnt]]
              - !<grocc::BRepAlgoAPI_Cut> [[armrest], [armrest_nobop, halfspace]]
            returns:
              - armrest
